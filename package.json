{
  "name": "veyra-forensics",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "build:vercel": "tsc --noEmit && vite build",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:live": "tsx tests/live-smoke.ts",
    "format:check": "prettier --check api src shared server tests scripts docs package.json tsconfig.json vite.config.ts playwright.config.ts eslint.config.js vercel.json README.md THIRD_PARTY_NOTICES.md",
    "profile": "node scripts/profile.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:proof": "node scripts/database-proof.mjs",
    "source:package": "node scripts/package-source.mjs",
    "source:check": "node scripts/check-source.mjs"
  },
  "dependencies": {
    "@auth/express": "^0.12.3",
    "@auth/pg-adapter": "^1.11.3",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@react-three/fiber": "^9.8.2",
    "compression": "^1.8.2",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "fflate": "^0.8.3",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "openai": "^7.34.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jose": "^6.2.12",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
